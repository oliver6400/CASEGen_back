# Leave empty when web and backend share an origin or when using the Vite proxy.
VITE_API_BASE_URL=

# Optional. Leave empty to derive ws(s)://.../ws from VITE_API_BASE_URL/current origin.
VITE_WS_URL=

# Used only by the Vite development and preview proxies.
CASEGEN_DEV_API_TARGET=http://localhost:8080
