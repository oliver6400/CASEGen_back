# =================================================================
# CASEGen - Production Environment Configuration Template
# =================================================================

# Server & Hostname
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
PUBLIC_DOMAIN=yourdomain.com

# PostgreSQL Database (e.g. AWS RDS PostgreSQL or Docker Container)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=casegen
DB_USERNAME=casegen_admin
DB_PASSWORD=ReplaceWithStrongProductionPassword123!

# JWT Security
# Must be at least 32 characters long
JWT_SECRET=production_casegen_super_secure_jwt_token_secret_key_32bytes_minimum!
JWT_EXPIRATION_HOURS=24

# AI provider used by CASEGen (OPENAI, OLLAMA or GEMINI)
AI_PROVIDER=OPENAI
AI_FALLBACK_PROVIDER=OLLAMA

# Ollama Production (Running on EC2 host or GPU instance)
AI_OLLAMA_BASE_URL=http://ollama:11434
AI_OLLAMA_MODEL=qwen3:4b
AI_OLLAMA_TIMEOUT=PT5M

# OpenAI cloud provider (primary)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=PT2M
OPENAI_REASONING_EFFORT=medium

# Image analysis reuses OPENAI_API_KEY unless IMAGE_IMPORT_API_KEY is set
IMAGE_IMPORT_PROVIDER=OPENAI
IMAGE_IMPORT_MODEL=gpt-6-luna
IMAGE_IMPORT_API_URL=https://api.openai.com/v1/responses
IMAGE_IMPORT_LOCAL_FALLBACK=true

# Gemini remains selectable for backwards compatibility
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# Vosk Speech-to-Text Path (Inside Docker container)
VOSK_MODEL_PATH=/opt/vosk-model-small-es

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:5173,http://localhost:3000

# AWS S3 Storage (Optional: If diagrams/exports are persisted in S3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=casegen-storage
