DB_URL=jdbc:postgresql://localhost:5432/casegen
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_TTL=PT1H
JWT_REFRESH_TOKEN_TTL=P30D
GENERATION_RUNTIME_ROOT=runtime/generation
GENERATION_PROCESS_TIMEOUT=PT10M
GENERATION_EXECUTOR_CORE_SIZE=1
GENERATION_EXECUTOR_MAX_SIZE=2
GENERATION_EXECUTOR_QUEUE_CAPACITY=20
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:[*],http://127.0.0.1:[*]
IMAGE_IMPORT_PROVIDER=OPENAI
IMAGE_IMPORT_MAX_BYTES=10485760
IMAGE_IMPORT_LOCAL_FALLBACK=true
TESSERACT_COMMAND=tesseract
TESSERACT_LANGUAGE=eng
IMAGE_IMPORT_LOCAL_MIN_WIDTH_RATIO=0.07
IMAGE_IMPORT_LOCAL_MIN_HEIGHT_RATIO=0.045
IMAGE_IMPORT_LOCAL_MIN_AREA_RATIO=0.004
IMAGE_IMPORT_LOCAL_MIN_RECTANGULARITY=0.42
IMAGE_IMPORT_LOCAL_MIN_ASPECT_RATIO=0.55
IMAGE_IMPORT_LOCAL_MAX_ASPECT_RATIO=5.5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=PT2M
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=PT2M
OPENAI_REASONING_EFFORT=medium
# Optional overrides. By default image import reuses OPENAI_API_KEY and OPENAI_MODEL.
IMAGE_IMPORT_API_KEY=
IMAGE_IMPORT_API_URL=https://api.openai.com/v1/responses
IMAGE_IMPORT_MODEL=gpt-6-luna
AI_PROVIDER=OPENAI
AI_FALLBACK_PROVIDER=OLLAMA
AI_MAX_MESSAGE_LENGTH=8000
AI_CONTEXT_MESSAGE_LIMIT=30
AI_CONTEXT_MAX_CHARS=24000
AI_OLLAMA_BASE_URL=http://localhost:11434
AI_OLLAMA_MODEL=qwen3:4b
AI_OLLAMA_TIMEOUT=PT5M
VOSK_MODEL_PATH=runtime/vosk-model-small-es-0.42
